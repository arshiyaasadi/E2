{
  "name": "@e2/file-service",
  "version": "0.1.0",
  "private": true,
  "description": "Product image metadata and signed/proxy access to MinIO",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "multer": "^2.0.2",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@e2/tsconfig": "0.0.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}

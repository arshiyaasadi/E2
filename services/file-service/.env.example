PORT=8080
SERVICE_VERSION=0.1.0
DEPLOYMENT_ENVIRONMENT=development

DATABASE_URL=postgres://file_service:REPLACE_DB_PASSWORD@localhost:5432/file_service

KEYCLOAK_ISSUER=https://REPLACE_KEYCLOAK_HOSTNAME/realms/operators
# Set to file-service when an audience mapper is configured; empty or * skips aud check
KEYCLOAK_AUDIENCE=
FILE_SERVICE_ALLOWED_CLIENTS=svc-store-backend

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=REPLACE_FILE_SERVICE_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_FILE_SERVICE_SECRET_KEY
MINIO_BUCKET=product-images
MINIO_FORCE_PATH_STYLE=true

PRODUCT_IMAGE_MAX_BYTES=5242880
UPLOAD_URL_TTL_SECONDS=300
DOWNLOAD_URL_TTL_SECONDS=300

OTEL_SERVICE_NAME=file-service
# Example in-cluster: http://signoz-otel-collector.platform-observability.svc:4317
OTEL_EXPORTER_OTLP_ENDPOINT=

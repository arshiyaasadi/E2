{
  "clientId": "minio-console",
  "name": "Object store console (file.abysso.ir)",
  "description": "OIDC for oauth2-proxy in front of the storage console. Secret not stored in Git.",
  "enabled": true,
  "publicClient": false,
  "secret": "REPLACE_AT_APPLY_TIME",
  "rootUrl": "https://file.abysso.ir",
  "redirectUris": [
    "https://file.abysso.ir/oauth2/callback",
    "https://file.abysso.ir/*"
  ],
  "webOrigins": [
    "https://file.abysso.ir"
  ],
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "protocol": "openid-connect",
  "attributes": {
    "pkce.code.challenge.method": "S256"
  }
}

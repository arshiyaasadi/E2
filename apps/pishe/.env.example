# ── Keycloak on the platform server (no local Keycloak / Docker) ──
KEYCLOAK_BASE_URL=https://sso.abysso.ir
KEYCLOAK_REALM=pishe
KEYCLOAK_APP_CLIENT_ID=pishe-app
KEYCLOAK_APP_CLIENT_SECRET=REPLACE_FROM_SECRET_MANAGER
KEYCLOAK_BFF_CLIENT_ID=pishe-bff
KEYCLOAK_BFF_CLIENT_SECRET=REPLACE_FROM_SECRET_MANAGER

# One-time: create realm on the server (yarn kc:create-realm)
# Use Keycloak *master* admin (not a realm user).
# KEYCLOAK_ADMIN_USER=
# KEYCLOAK_ADMIN_PASSWORD=

# Optional: seed flamingo-manager against the server realm
# PISHE_MANAGER_PASSWORD=FlamingoManager1

# Optional: ship structured logs to SigNoz (WireGuard OTLP/HTTP, not public).
# Required for Logs + Alert Rules on noz.abysso.ir while running locally.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://10.66.0.2:4318

# ── file-service (product photos; ClusterIP via kubectl port-forward) ──
# kubectl -n services-file port-forward svc/file-service 8088:80
# kubectl -n platform-storage port-forward svc/minio 9000:9000
FILE_SERVICE_BASE_URL=http://127.0.0.1:8088
FILE_SERVICE_KEYCLOAK_ISSUER=https://sso.abysso.ir/realms/operators
FILE_SERVICE_CLIENT_ID=svc-store-backend
FILE_SERVICE_CLIENT_SECRET=REPLACE_FROM_SECRET_MANAGER
FILE_SERVICE_PRESIGN_CONNECT=127.0.0.1:9000

# ── Pishe Postgres (Server host — not local Docker) ──────────
# Prefer hostname once Arvan Cloud Off → 185.194.191.10
# DATABASE_URL=postgresql://pishe:PASSWORD@pg.abysso.ir:5432/pishe?schema=public
DATABASE_URL=postgresql://pishe:PASSWORD@185.194.191.10:5432/pishe?schema=public

# ── Telegram bot (BFF service token; bot username public) ──
TELEGRAM_BOT_USERNAME=e2pishe_bot
TELEGRAM_BOT_SERVICE_TOKEN=REPLACE_FROM_SECRET_MANAGER

# ── App (frontend only on your machine) ──────────────────────
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=Pishe
NEXT_PUBLIC_APP_URL=http://localhost:3010

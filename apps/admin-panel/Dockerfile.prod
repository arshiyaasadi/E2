# Production Next.js admin (Prisma BFF).
# NEXT_PUBLIC_* must be present at `next build` time (baked into the client bundle).
# Use Debian (glibc) — Alpine/musl sharp optional deps are unreliable with yarn --ignore-scripts.

FROM node:22-bookworm-slim AS deps
WORKDIR /app
RUN npm install -g yarn@1.22.22 --force
COPY package.json yarn.lock* ./
RUN yarn install --frozen-lockfile --ignore-scripts \
  || yarn install --network-timeout 600000 --ignore-scripts
# Ensure linux/glibc sharp + libvips binaries for this image (yarn may skip optionals).
RUN npm install --os=linux --cpu=x64 --include=optional sharp@0.35.3

FROM node:22-bookworm-slim AS builder
WORKDIR /app
RUN npm install -g yarn@1.22.22 --force
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Next always expects ./public at runtime; ensure it exists even if empty in git.
RUN mkdir -p public

ARG NEXT_PUBLIC_APP_ENV=production
ARG NEXT_PUBLIC_APP_NAME="HAMPAM Shop"
ARG NEXT_PUBLIC_SITE_URL=https://shop.abysso.ir
ARG NEXT_PUBLIC_APP_URL=https://shop.abysso.ir

ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_APP_ENV=$NEXT_PUBLIC_APP_ENV
ENV NEXT_PUBLIC_APP_NAME="$NEXT_PUBLIC_APP_NAME"
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
# Placeholders so `next build` can collect pages (serverEnv validates at import).
# Real DATABASE_URL / AUTH_SECRET come from compose at runtime.
ENV DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build?schema=public
ENV AUTH_SECRET=build_time_placeholder_secret_min_32_chars
ENV KEYCLOAK_CLIENT_SECRET=build_time_placeholder_kc_secret
ENV KEYCLOAK_ISSUER=https://sso.abysso.ir/realms/abysso
ENV KEYCLOAK_CLIENT_ID=ecommerce-flamingo-admin
ENV AUTH_COOKIE_DOMAIN=.abysso.ir
ENV APP_ENV=production

RUN yarn db:generate
RUN yarn build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
RUN npm install -g yarn@1.22.22 --force
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV NEXT_PUBLIC_APP_ENV=production
ENV NEXT_PUBLIC_APP_NAME="HAMPAM Shop"
ENV NEXT_PUBLIC_SITE_URL=https://shop.abysso.ir
ENV NEXT_PUBLIC_APP_URL=https://shop.abysso.ir

COPY --from=builder /app/package.json ./
COPY --from=builder /app/yarn.lock ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/next.config.* ./

EXPOSE 3000
CMD ["yarn", "start", "-H", "0.0.0.0", "-p", "3000"]

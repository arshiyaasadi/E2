// Admin panel UI lab schema (SQLite file). PostgreSQL reference: schema.postgresql.prisma
// Platform microservices are out of scope for APP_MODE=ui.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  draft
  active
  archived

  @@map("product_status")
}

enum ProductType {
  physical
  digital

  @@map("product_type")
}

enum ActorType {
  admin
  customer
  system

  @@map("actor_type")
}

enum CouponBenefitType {
  percentage
  fixed
  free_shipping

  @@map("coupon_benefit_type")
}

enum CouponScopeType {
  order
  category
  product
  first_order

  @@map("coupon_scope_type")
}

enum PromotionType {
  percentage
  fixed

  @@map("promotion_type")
}

enum PromotionTargetType {
  category
  product

  @@map("promotion_target_type")
}

enum OrderStatus {
  pending
  paid
  processing
  shipped
  delivered
  cancelled
  refunded

  @@map("order_status")
}

enum PaymentStatus {
  pending
  authorized
  paid
  failed
  refunded
  partial_refund

  @@map("payment_status")
}

enum AddressType {
  shipping
  billing

  @@map("address_type")
}

enum BlogPostStatus {
  draft
  pending
  published

  @@map("blog_post_status")
}

enum ShopPageType {
  search
  landing

  @@map("shop_page_type")
}

enum ShopPageStatus {
  draft
  published

  @@map("shop_page_status")
}

enum HomepageSectionType {
  product_grid
  product_rail
  sale_grid

  @@map("homepage_section_type")
}

enum CategoryKind {
  real
  virtual

  @@map("category_kind")
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  adminUsers  AdminUser[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid())
  key         String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AdminUser {
  id           String    @id @default(uuid())
  roleId       String?   @map("role_id")
  email        String    @unique
  passwordHash String?   @map("password_hash")
  keycloakSub  String?   @map("keycloak_sub")
  fullName     String?   @map("full_name")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  role Role? @relation(fields: [roleId], references: [id])
  blogPosts BlogPost[]

  @@map("admin_users")
}

model StoreSettings {
  id                    String   @id @default(uuid())
  taxRate               Decimal  @default(0) @map("tax_rate")
  currency              String   @default("IRR")
  cartTtlSeconds        Int      @default(1800) @map("cart_ttl_seconds")
  reservationTtlSeconds Int      @default(900) @map("reservation_ttl_seconds")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("store_settings")
}

model Product {
  id             String        @id @default(uuid())
  categoryId     String?       @map("category_id")
  brandId        String?       @map("brand_id")
  title          String
  slug           String        @unique
  description    String?
  descriptionBlocks Json @map("description_blocks")
  productType    ProductType   @default(physical) @map("product_type")
  status         ProductStatus @default(draft)
  basePrice      Decimal?      @map("base_price")
  comparePrice   Decimal?      @map("compare_price")
  isRefundable   Boolean       @default(true) @map("is_refundable")
  isFeatured     Boolean       @default(false) @map("is_featured")
  popularityScore Int          @default(0) @map("popularity_score")
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  ogTitle        String?       @map("og_title")
  ogDescription  String?       @map("og_description")
  ogImageId      String?       @map("og_image_id")
  canonicalUrl   String?       @map("canonical_url")
  metaRobots     String        @default("index,follow") @map("meta_robots")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  category Category?      @relation(fields: [categoryId], references: [id])
  brand    Brand?         @relation(fields: [brandId], references: [id])
  ogImage  Media?         @relation("ProductOgImage", fields: [ogImageId], references: [id])
  media        ProductMedia[]
  categories   ProductCategory[]
  tags         ProductTag[]
  options      ProductOption[]
  variants     ProductVariant[]
  priceHistory PriceHistory[]
  history      ProductHistory[]
  wishlists    Wishlist[]
  categoryPins CategoryPinnedProduct[]

  @@map("products")
}

model ProductCategory {
  productId  String   @map("product_id")
  categoryId String   @map("category_id")
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation("ProductCategoryLinks", fields: [categoryId], references: [id])

  @@id([productId, categoryId])
  @@map("product_categories")
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  nameFa    String    @map("name_fa")
  slug      String    @unique
  imageId   String?   @map("image_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  image    Media?    @relation("BrandImage", fields: [imageId], references: [id])
  products Product[]

  @@map("brands")
}

model ProductMedia {
  productId String    @map("product_id")
  mediaId   String    @map("media_id")
  position  Int       @default(0)
  deletedAt DateTime? @map("deleted_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id])

  @@id([productId, mediaId])
  @@map("product_media")
}

model Customer {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?   @map("password_hash")
  fullName     String?   @map("full_name")
  phone        String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  addresses    CustomerAddress[]
  loginLogs    CustomerLoginLog[]
  orders       Order[]
  wishlists    Wishlist[]
  carts        Cart[]
  couponUsages CouponUsage[]

  @@map("customers")
}

model CustomerAddress {
  id             String      @id @default(uuid())
  customerId     String      @map("customer_id")
  type           AddressType
  fullName       String      @map("full_name")
  phone          String
  province       String
  city           String
  provinceId     Int?        @map("province_id")
  cityId         BigInt?     @map("city_id")
  addressLine    String      @map("address_line")
  buildingNumber String?     @map("building_number")
  unit           String?
  floor          String?     @map("floor")
  postalCode     String?     @map("postal_code")
  latitude       Decimal?    @map("latitude")
  longitude      Decimal?    @map("longitude")
  tipaxCityId    Int?        @map("tipax_city_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("customer_addresses")
}

model CustomerLoginLog {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  method     String
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt(sort: Desc)], map: "customer_login_logs_customer_created_idx")
  @@map("customer_login_logs")
}

model ShippingMethod {
  id          String    @id @default(uuid())
  name        String
  description String?
  baseCost    Decimal   @map("base_cost")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  orders Order[]

  @@map("shipping_methods")
}

model Order {
  id                 String      @id @default(uuid())
  customerId         String      @map("customer_id")
  couponId           String?     @map("coupon_id")
  shippingMethodId   String?     @map("shipping_method_id")
  orderNumber        String      @unique @map("order_number")
  status             OrderStatus @default(pending)
  currency           String      @default("IRR")
  subtotal           Decimal
  discountTotal      Decimal     @default(0) @map("discount_total")
  taxTotal           Decimal     @default(0) @map("tax_total")
  shippingTotal      Decimal     @default(0) @map("shipping_total")
  grandTotal         Decimal     @map("grand_total")
  couponCode         String?     @map("coupon_code")
  shippingMethodName String?     @map("shipping_method_name")
  shippingAddress    Json        @map("shipping_address")
  trackingNumber     String?     @map("tracking_number")
  shippedAt          DateTime?   @map("shipped_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at")
  deletedAt          DateTime?   @map("deleted_at")

  customer       Customer             @relation(fields: [customerId], references: [id])
  coupon         Coupon?              @relation(fields: [couponId], references: [id])
  shippingMethod ShippingMethod?      @relation(fields: [shippingMethodId], references: [id])
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  payments       Payment[]
  couponUsages   CouponUsage[]

  @@map("orders")
}

model OrderItem {
  id           String    @id @default(uuid())
  orderId      String    @map("order_id")
  variantId    String    @map("variant_id")
  productTitle String    @map("product_title")
  variantSku   String    @map("variant_sku")
  variantLabel String?   @map("variant_label")
  unitPrice    Decimal   @map("unit_price")
  quantity     Int
  taxAmount    Decimal   @default(0) @map("tax_amount")
  lineTotal    Decimal   @map("line_total")
  deletedAt    DateTime? @map("deleted_at")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid())
  orderId    String       @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorType  ActorType    @map("actor_type")
  actorId    String?      @map("actor_id")
  note       String?
  createdAt  DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

model Payment {
  id           String        @id @default(uuid())
  orderId      String        @map("order_id")
  gatewayId    String        @map("gateway_id")
  amount       Decimal
  currency     String        @default("IRR")
  status       PaymentStatus @default(pending)
  externalId   String?       @map("external_id")
  callbackData Json?         @map("callback_data")
  mediaId      String?       @map("media_id")
  rejectReason String?       @map("reject_reason")
  reviewedAt   DateTime?     @map("reviewed_at")
  reviewedBy   String?       @map("reviewed_by")
  paidAt       DateTime?     @map("paid_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  order Order  @relation(fields: [orderId], references: [id])
  media Media? @relation("PaymentReceipt", fields: [mediaId], references: [id])

  @@map("payments")
}

model Wishlist {
  customerId String    @map("customer_id")
  productId  String    @map("product_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  deletedAt  DateTime? @map("deleted_at")

  customer Customer @relation(fields: [customerId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@id([customerId, productId])
  @@map("wishlists")
}

model Cart {
  id         String    @id @default(uuid())
  customerId String    @map("customer_id")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  customer     Customer  @relation(fields: [customerId], references: [id])
  items        CartItem[]

  @@map("carts")
}

model CartItem {
  id        String    @id @default(uuid())
  cartId    String    @map("cart_id")
  variantId String    @map("variant_id")
  quantity  Int
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model CouponUsage {
  id         String   @id @default(uuid())
  couponId   String   @map("coupon_id")
  customerId String   @map("customer_id")
  orderId    String   @map("order_id")
  usedAt     DateTime @default(now()) @map("used_at")

  coupon   Coupon   @relation(fields: [couponId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])

  @@map("coupon_usages")
}

model Media {
  id         String    @id @default(uuid())
  storageKey String    @map("storage_key")
  url        String
  thumbUrl   String?   @map("thumb_url")
  folder     String    @default("general")
  title      String?
  altText    String?   @map("alt_text")
  width      Int?
  height     Int?
  mimeType   String?   @map("mime_type")
  createdAt  DateTime  @default(now()) @map("created_at")
  deletedAt  DateTime? @map("deleted_at")

  categoryImages   Category[]     @relation("CategoryImage")
  categoryOgImages Category[]     @relation("CategoryOgImage")
  categoryMedia    CategoryMedia[]
  brandImages      Brand[]        @relation("BrandImage")
  productOgImages  Product[]      @relation("ProductOgImage")
  productMedia     ProductMedia[]
  variantImages    ProductVariant[] @relation("VariantMedia")
  blogCoverImages  BlogPost[]     @relation("BlogCoverImage")
  blogOgImages     BlogPost[]     @relation("BlogOgImage")
  shopPageSeoImages ShopPage[]    @relation("ShopPageSeoImage")
  paymentReceipts  Payment[]      @relation("PaymentReceipt")

  @@map("media")
}

model Category {
  id                 String       @id @default(uuid())
  parentId           String?      @map("parent_id")
  name               String
  nameFa             String       @map("name_fa")
  slug               String       @unique
  description        String?
  kind               CategoryKind @default(real)
  menuVisible        Boolean      @default(true) @map("menu_visible")
  filters            Json
  descriptionBlocks  Json @map("description_blocks")
  pageSettings       Json @map("page_settings")
  seoTitle           String?      @map("seo_title")
  seoDescription     String?      @map("seo_description")
  ogTitle            String?      @map("og_title")
  ogDescription      String?      @map("og_description")
  ogImageId          String?      @map("og_image_id")
  imageId            String?      @map("image_id")
  canonicalUrl       String?      @map("canonical_url")
  metaRobots         String       @default("index,follow") @map("meta_robots")
  position           Int          @default(0)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at")
  deletedAt          DateTime?    @map("deleted_at")

  parent          Category?                @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[]               @relation("CategoryTree")
  image           Media?                   @relation("CategoryImage", fields: [imageId], references: [id])
  ogImage         Media?                   @relation("CategoryOgImage", fields: [ogImageId], references: [id])
  products        Product[]
  productLinks    ProductCategory[]        @relation("ProductCategoryLinks")
  mediaLinks      CategoryMedia[]
  pinnedProducts  CategoryPinnedProduct[]

  @@map("categories")
}

model CategoryMedia {
  categoryId String   @map("category_id")
  mediaId    String   @map("media_id")
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  media    Media    @relation(fields: [mediaId], references: [id])

  @@id([categoryId, mediaId])
  @@map("category_media")
}

model CategoryPinnedProduct {
  categoryId String   @map("category_id")
  productId  String   @map("product_id")
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([categoryId, productId])
  @@map("category_pinned_products")
}

model Tag {
  id        String    @id @default(uuid())
  name      String
  nameFa    String    @map("name_fa")
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String   @map("product_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id])

  @@id([productId, tagId])
  @@map("product_tags")
}

model ProductOption {
  id        String @id @default(uuid())
  productId String @map("product_id")
  name      String
  position  Int    @default(0)

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  OptionValue[]

  @@map("product_options")
}

model OptionValue {
  id       String @id @default(uuid())
  optionId String @map("option_id")
  value    String
  position Int    @default(0)

  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants VariantOptionValue[]

  @@map("option_values")
}

model ProductVariant {
  id           String    @id @default(uuid())
  productId    String    @map("product_id")
  sku          String    @unique
  price        Decimal?
  comparePrice Decimal?  @map("compare_price")
  mediaId      String?   @map("media_id")
  isDefault    Boolean   @default(false) @map("is_default")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  media        Media?               @relation("VariantMedia", fields: [mediaId], references: [id])
  optionValues VariantOptionValue[]
  priceHistory PriceHistory[]
  orderItems     OrderItem[]
  cartItems      CartItem[]

  @@map("product_variants")
}

model VariantOptionValue {
  variantId     String @map("variant_id")
  optionValueId String @map("option_value_id")

  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue OptionValue    @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@map("variant_option_values")
}

model PriceHistory {
  id        String    @id @default(uuid())
  variantId String?   @map("variant_id")
  productId String?   @map("product_id")
  oldPrice  Decimal?  @map("old_price")
  newPrice  Decimal   @map("new_price")
  actorType ActorType @map("actor_type")
  actorId   String?   @map("actor_id")
  createdAt DateTime  @default(now()) @map("created_at")

  variant ProductVariant? @relation(fields: [variantId], references: [id])
  product Product?        @relation(fields: [productId], references: [id])

  @@map("price_history")
}

model ProductHistory {
  id        String    @id @default(uuid())
  productId String    @map("product_id")
  snapshot  Json
  actorType ActorType @map("actor_type")
  actorId   String?   @map("actor_id")
  createdAt DateTime  @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_history")
}

model Coupon {
  id                 String            @id @default(uuid())
  code               String            @unique
  benefitType        CouponBenefitType @map("benefit_type")
  value              Decimal @default(0)
  minOrderAmount     Decimal?          @map("min_order_amount")
  maxDiscount        Decimal?          @map("max_discount")
  maxUses            Int?              @map("max_uses")
  maxUsesPerCustomer Int?              @map("max_uses_per_customer")
  usedCount          Int               @default(0) @map("used_count")
  startsAt           DateTime?         @map("starts_at")
  endsAt             DateTime?         @map("ends_at")
  isActive           Boolean           @default(true) @map("is_active")
  isWelcome          Boolean           @default(false) @map("is_welcome")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at")
  deletedAt          DateTime?         @map("deleted_at")

  scopes CouponScope[]
  orders Order[]
  usages CouponUsage[]

  @@map("coupons")
}

model CouponScope {
  id        String          @id @default(uuid())
  couponId  String          @map("coupon_id")
  scopeType CouponScopeType @map("scope_type")
  scopeId   String?         @map("scope_id")
  createdAt DateTime        @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@map("coupon_scopes")
}

model Promotion {
  id        String        @id @default(uuid())
  name      String
  type      PromotionType
  value     Decimal
  startsAt  DateTime?     @map("starts_at")
  endsAt    DateTime?     @map("ends_at")
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime?     @map("deleted_at")

  targets PromotionTarget[]

  @@map("promotions")
}

model PromotionTarget {
  id          String              @id @default(uuid())
  promotionId String              @map("promotion_id")
  targetType  PromotionTargetType @map("target_type")
  targetId    String              @map("target_id")
  createdAt   DateTime            @default(now()) @map("created_at")

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@map("promotion_targets")
}

model BlogCategory {
  id          String    @id @default(uuid())
  parentId    String?   @map("parent_id")
  name        String?
  nameFa      String    @map("name_fa")
  slug        String    @unique
  description String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  parent   BlogCategory?  @relation("BlogCategoryTree", fields: [parentId], references: [id])
  children BlogCategory[] @relation("BlogCategoryTree")
  posts    BlogPostCategory[]

  @@map("blog_categories")
}

model BlogTag {
  id        String    @id @default(uuid())
  name      String?
  nameFa    String    @map("name_fa")
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  posts BlogPostTag[]

  @@map("blog_tags")
}

model BlogPost {
  id             String         @id @default(uuid())
  title          String?
  titleFa        String         @map("title_fa")
  slug           String         @unique
  excerpt        String?
  excerptFa      String?        @map("excerpt_fa")
  content        Json
  coverImageId   String?        @map("cover_image_id")
  authorAdminId  String?        @map("author_admin_id")
  status         BlogPostStatus @default(draft)
  scheduledAt    DateTime?      @map("scheduled_at")
  publishedAt    DateTime?      @map("published_at")
  seoTitle       String?        @map("seo_title")
  seoDescription String?        @map("seo_description")
  ogTitle        String?        @map("og_title")
  ogDescription  String?        @map("og_description")
  ogImageId      String?        @map("og_image_id")
  canonicalUrl   String?        @map("canonical_url")
  metaRobots     String         @default("index,follow") @map("meta_robots")
  faqItems       Json @map("faq_items")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  coverImage Media?     @relation("BlogCoverImage", fields: [coverImageId], references: [id])
  ogImage    Media?     @relation("BlogOgImage", fields: [ogImageId], references: [id])
  author     AdminUser? @relation(fields: [authorAdminId], references: [id])
  categories BlogPostCategory[]
  tags       BlogPostTag[]
  history    BlogPostHistory[]

  @@map("blog_posts")
}

model BlogPostCategory {
  postId     String   @map("post_id")
  categoryId String   @map("category_id")
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  post     BlogPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category BlogCategory @relation(fields: [categoryId], references: [id])

  @@id([postId, categoryId])
  @@map("blog_post_categories")
}

model BlogPostTag {
  postId    String   @map("post_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id])

  @@id([postId, tagId])
  @@map("blog_post_tags")
}

model BlogPostHistory {
  id        String    @id @default(uuid())
  postId    String    @map("post_id")
  snapshot  Json
  actorType ActorType @map("actor_type")
  actorId   String?   @map("actor_id")
  createdAt DateTime  @default(now()) @map("created_at")

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("blog_post_history")
}

model ShopPage {
  id               String         @id @default(uuid())
  slug             String
  title            String
  titleFa          String?        @map("title_fa")
  description      String?
  type             ShopPageType
  status           ShopPageStatus @default(draft)
  isMain           Boolean        @default(false) @map("is_main")
  mapsCategorySlug String?        @map("maps_category_slug")
  filters          Json
  pinnedProductIds Json @map("pinned_product_ids")
  blocks           Json
  seoTitle         String?        @map("seo_title")
  seoDescription   String?        @map("seo_description")
  seoImageId       String?        @map("seo_image_id")
  sortOrder        Int            @default(0) @map("sort_order")
  publishedAt      DateTime?      @map("published_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  seoImage Media? @relation("ShopPageSeoImage", fields: [seoImageId], references: [id])
  homepageSections HomepageSection[]

  @@map("shop_pages")
}

model HomepageSection {
  id           String               @id @default(uuid())
  title        String
  subtitle     String?
  sectionType  HomepageSectionType  @default(product_grid) @map("section_type")
  filters      Json
  shopPageId   String?              @map("shop_page_id")
  productLimit Int                  @default(8) @map("product_limit")
  gridLayout   String               @default("cols4") @map("grid_layout")
  sortOrder    Int                  @default(0) @map("sort_order")
  isEnabled    Boolean              @default(true) @map("is_enabled")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")

  shopPage ShopPage? @relation(fields: [shopPageId], references: [id])

  @@map("homepage_sections")
}

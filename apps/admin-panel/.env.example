# ── App mode ─────────────────────────────────────────────────
# ui       = local feature lab (SQLite file, password login, local media)
# platform = later: Postgres + Keycloak + MinIO (not required for UI work)
APP_MODE=ui
NEXT_PUBLIC_APP_MODE=ui

# ── Database (UI mode: SQLite file only) ──────────────────────
DATABASE_URL="file:./prisma/dev-ui.db"

# ── Auth ─────────────────────────────────────────────────────
AUTH_SECRET=dev_ui_auth_secret_change_me_32chars_min
AUTH_COOKIE_DOMAIN=

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=E2 Admin (UI Lab)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:3000/uploads

# ── Media (UI mode writes under public/uploads; MinIO not required)
MEDIA_DRIVER=local

# ── Platform-only (optional; ignored when APP_MODE=ui) ────────
# KEYCLOAK_ISSUER=
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_CLIENT_SECRET=
# MINIO_ENDPOINT=
# MINIO_PORT=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=
# MINIO_PUBLIC_URL=
